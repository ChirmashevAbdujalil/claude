# Nusxa oling: cp .env.example .env

# Lokal ishlab chiqishda 1, serverda 0
DJANGO_DEBUG=1
# Serverda majburiy: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL (bo'sh qolsa SQLite ishlatiladi)
POSTGRES_DB=
POSTGRES_USER=talenthub
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Saytning tashqi manzili (Telegram tugmalari uchun), masalan https://talent.andti.uz
SITE_URL=

# Talabalar o'zlari ro'yxatdan o'ta olsinmi (1 = ha)
REGISTRATION_OPEN=1

# Telegram bot (@BotFather dan olinadi). Ulash: python manage.py telegram_setup
TELEGRAM_BOT_TOKEN=
# Webhook himoyasi uchun uzun tasodifiy satr (bot ulash uchun majburiy)
TELEGRAM_WEBHOOK_SECRET=

# AI Mentor (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_DAILY_MESSAGE_LIMIT=30

# Kunlik XP limiti (ballni sun'iy ko'paytirishdan himoya)
ARENA_DAILY_XP_CAP=1000
