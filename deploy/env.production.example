# iqtidorasti.uz uchun production sozlamalari.
# Serverda backend/.env nomi bilan saqlang. install_vps.sh bu faylni o'zi yaratadi (maxfiy kalit va parol bilan).

DJANGO_DEBUG=0
# Yangi kalit: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=iqtidorasti.uz,www.iqtidorasti.uz
# Bo'sh qolsa ALLOWED_HOSTS dan avtomatik: https://iqtidorasti.uz, https://www.iqtidorasti.uz
DJANGO_CSRF_TRUSTED_ORIGINS=
# nginx yoki hosting paneli HTTP->HTTPS yo'naltirmasa 1 qiling
DJANGO_SECURE_SSL_REDIRECT=0
# SSL ishlayotganiga ishonch hosil qilgach: 31536000
DJANGO_HSTS_SECONDS=0

SITE_URL=https://iqtidorasti.uz

# --- Ma'lumotlar bazasi: faqat bittasini to'ldiring ---
# VPS: PostgreSQL (tavsiya)
POSTGRES_DB=iqtidorasti
POSTGRES_USER=iqtidor
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# cPanel hosting: MySQL (POSTGRES_DB ni bo'sh qoldiring). pip install PyMySQL kerak
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=localhost
# Ikkalasi ham bo'sh bo'lsa SQLite ishlatiladi (backend/db.sqlite3)

# Server nginx ortida bo'lsa 1 (harakatlar jurnaliga haqiqiy IP yoziladi)
AUDIT_TRUST_X_FORWARDED_FOR=1
# Xatolar jurnali fayli (ixtiyoriy)
LOG_FILE=

REGISTRATION_OPEN=1
DEFAULT_INSTITUTION_SLUG=andti
DEFAULT_INSTITUTION_NAME=Andijon davlat texnika instituti
DEFAULT_INSTITUTION_SHORT=ANDTI
# Bitta OTM uchun bo'sh qoladi. Bir nechta OTM (andti.iqtidorasti.uz kabi) bo'lsa: iqtidorasti.uz
SAAS_BASE_DOMAIN=

# Ixtiyoriy
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
SPONSOR_CONTACT=@abdujalil_chirmashev
